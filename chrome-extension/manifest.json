{
  "manifest_version": 3,
  "name": "Data 360 Inspector",
  "version": "1.2.1",
  "description": "Inspects Data Cloud / Data 360 mappings and segment rules. Shows API names on the mapping canvas, exports segment conditions to HTML or Sheets. Read-only; nothing leaves your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Data 360 Inspector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "scripting",
    "activeTab",
    "bookmarks"
  ],
  "host_permissions": [
    "https://*.lightning.force.com/*",
    "https://*.salesforce.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.force.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "bookmarklet.txt"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
