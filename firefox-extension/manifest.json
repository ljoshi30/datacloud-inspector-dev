{
  "manifest_version": 3,
  "name": "Data 360 Inspector",
  "version": "1.2.120",
  "description": "Inspects Data Cloud / Data 360 mappings and segment rules. Shows API names on the mapping canvas, exports segment conditions to HTML or Sheets. Read-only; nothing leaves your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Data 360 Inspector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "scripting",
    "activeTab",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://*.lightning.force.com/*",
    "https://*.salesforce.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.force.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*.sfproxy.devx-preprod.aws-esvc1-useast2.aws.sfdc.cl/*",
    "https://*.sfdc.cl/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.salesforce.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.force.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "data360-inspector@ljoshi30",
      "strict_min_version": "128.0"
    }
  }
}
